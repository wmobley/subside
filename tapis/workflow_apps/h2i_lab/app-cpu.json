{
  "id": "subside-h2i-opera-analysis",
  "version": "0.1.1",
  "description": "Run the SUBSIDE H2I Lab OPERA DISP-S1 download/subset/preview analysis as a batch job.",
  "owner": "${apiUserId}",
  "enabled": true,
  "runtime": "SINGULARITY",
  "runtimeVersion": null,
  "runtimeOptions": [
    "SINGULARITY_RUN"
  ],
  "containerImage": "docker://ghcr.io/wmobley/subside-h2i-opera-analysis:sha-07c92cf",
  "jobType": "BATCH",
  "maxJobs": -1,
  "maxJobsPerUser": -1,
  "strictFileInputs": false,
  "jobAttributes": {
    "description": null,
    "dynamicExecSystem": false,
    "execSystemConstraints": null,
    "execSystemId": "ls6",
    "execSystemExecDir": "${JobWorkingDir}",
    "execSystemInputDir": "${JobWorkingDir}",
    "execSystemOutputDir": "${JobWorkingDir}/output",
    "execSystemLogicalQueue": "vm-small",
    "archiveSystemId": "ls6",
    "archiveSystemDir": "HOST_EVAL($WORK)/tapis-jobs-archive/${JobCreateDate}/${JobName}-${JobUUID}",
    "archiveOnAppError": true,
    "isMpi": false,
    "mpiCmd": null,
    "cmdPrefix": "mkdir -p $PWD/output $PWD/config;",
    "parameterSet": {
      "appArgs": [
        {
          "name": "Run config path",
          "description": "Path to the staged SUBSIDE H2I run config JSON.",
          "inputMode": "FIXED",
          "arg": "config/run-config.json",
          "notes": {
            "isHidden": true
          }
        },
        {
          "name": "Output directory",
          "description": "Directory where the app writes manifest and artifacts.",
          "inputMode": "FIXED",
          "arg": "output",
          "notes": {
            "isHidden": true
          }
        }
      ],
      "schedulerOptions": [
        {
          "name": "TACC Scheduler Profile",
          "description": "Scheduler profile for HPC clusters at TACC.",
          "inputMode": "FIXED",
          "arg": "--tapis-profile tacc-apptainer",
          "notes": {
            "isHidden": true
          }
        },
        {
          "name": "TACC Allocation",
          "description": "TACC allocation charged for SUBSIDE analysis jobs.",
          "inputMode": "INCLUDE_ON_DEMAND",
          "arg": null,
          "notes": {
            "isHidden": true
          }
        }
      ],
      "envVariables": [
        {
          "key": "START_DATE",
          "value": "2024-01-01",
          "description": "Search window start date (YYYY-MM-DD) for OPERA DISP-S1 products.",
          "inputMode": "REQUIRED",
          "notes": {
            "label": "Start date"
          }
        },
        {
          "key": "END_DATE",
          "value": "2025-01-01",
          "description": "Search window end date (YYYY-MM-DD) for OPERA DISP-S1 products.",
          "inputMode": "REQUIRED",
          "notes": {
            "label": "End date"
          }
        },
        {
          "key": "AOI_GEOJSON_PATH",
          "value": "config/aoi.geojson",
          "description": "Path to the AOI GeoJSON inside the job dir. Keep the default when supplying the aoi-geojson file input; clear it to search by frame IDs only.",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "notes": {
            "label": "AOI GeoJSON path"
          }
        },
        {
          "key": "FRAME_IDS",
          "value": "",
          "description": "Optional comma-separated OPERA frame IDs to restrict the search (e.g. 8882,8883). Leave blank to derive frames from the AOI.",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "notes": {
            "label": "Frame IDs"
          }
        },
        {
          "key": "NUM_WORKERS",
          "value": "8",
          "description": "Number of parallel download workers (I/O-bound; the job holds 16 cores).",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "notes": {
            "label": "Download workers"
          }
        },
        {
          "key": "MIN_OVERLAP_PERCENT",
          "value": "50",
          "description": "Minimum AOI/frame overlap percent for a frame to be included.",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "notes": {
            "label": "Min overlap percent"
          }
        },
        {
          "key": "RESULTS_DIR",
          "value": "OPERA_L3_DISP-S1",
          "description": "Subdirectory under the output dir where downloaded products are written.",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "notes": {
            "label": "Results subdirectory"
          }
        },
        {
          "key": "REQUIRE_PRODUCTS",
          "value": "true",
          "description": "Fail the job if no matching products are found.",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "notes": {
            "label": "Require products",
            "enum_values": [
              {
                "true": "true"
              },
              {
                "false": "false"
              }
            ]
          }
        },
        {
          "key": "PREVIEW_ONLY",
          "value": "false",
          "description": "Run discovery + preview only, skipping the full download and archive.",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "notes": {
            "label": "Preview only",
            "enum_values": [
              {
                "true": "true"
              },
              {
                "false": "false"
              }
            ]
          }
        },
        {
          "key": "UPDATE_CONDA_ENV",
          "value": "false",
          "description": "Set to 'true' to force run.sh to delete and recreate the conda environment under $WORK before running the analysis. Useful after bumping environment.yaml.",
          "inputMode": "INCLUDE_ON_DEMAND"
        }
      ],
      "archiveFilter": {
        "includes": [],
        "excludes": [],
        "includeLaunchFiles": true
      }
    },
    "fileInputs": [
      {
        "name": "aoi-geojson",
        "description": "Optional AOI GeoJSON used by the run config.",
        "inputMode": "OPTIONAL",
        "autoMountLocal": true,
        "sourceUrl": null,
        "targetPath": "config/aoi.geojson"
      },
      {
        "name": "earthdata-netrc",
        "description": "Optional protected Earthdata .netrc file. Prefer Tapis secrets before production registration.",
        "inputMode": "OPTIONAL",
        "autoMountLocal": true,
        "sourceUrl": null,
        "targetPath": ".netrc"
      }
    ],
    "fileInputArrays": [],
    "nodeCount": 1,
    "coresPerNode": 16,
    "memoryMB": 128000,
    "maxMinutes": 240,
    "subscriptions": [],
    "tags": []
  },
  "tags": [
    "portalName: PTDATAX",
    "subside",
    "opera-disp-s1",
    "h2i-lab"
  ],
  "notes": {
    "label": "SUBSIDE H2I OPERA Analysis",
    "hideNodeCountAndCoresPerNode": true,
    "isInteractive": false,
    "icon": "satellite",
    "category": "Data Processing",
    "queueFilter": [
      "vm-small",
      "development"
    ]
  }
}
