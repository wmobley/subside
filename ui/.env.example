# Copy to .env.local for local development. Every key can also be injected at
# container start through window.__SUBSIDE_CONFIG__ (see src/lib/runtimeConfig.js).

# Where runs are submitted/listed: "legacy" (SUBSIDE API + Tapis Workflows, the
# default) or "dynamo" (MINT Ensemble Manager). Development switch.
VITE_RUN_BACKEND=dynamo

# MINT Ensemble Manager base URL including the API version. Only used when
# VITE_RUN_BACKEND=dynamo. Local compose stack:
VITE_DYNAMO_API_BASE=http://localhost:3001/v1
