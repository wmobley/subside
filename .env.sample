# SUBSIDE API local config — copy to `.env` and fill in. `.env` is gitignored.
#   cp .env.sample .env
# Loaded by api/config.py via python-dotenv when the API starts.

# --- NASA Earthdata service account ---------------------------------------
# Dedicated Earthdata Login account used to download OPERA DISP-S1 products.
# The API builds a .netrc from these and stages it with each run, so download
# credentials never travel in the API request body. Register/manage at
# https://urs.earthdata.nasa.gov/ (a service/functional account, not a
# personal login).
EARTHDATA_USERNAME=your-earthdata-service-account
EARTHDATA_PASSWORD=your-earthdata-service-password

# --- TACC allocation ------------------------------------------------------
# Default allocation charged for runs when a request omits "allocation".
SUBSIDE_DEFAULT_ALLOCATION=PT2050-DataX

# --- Tapis / staging (defaults are usually fine) --------------------------
# TAPIS_BASE_URL=https://portals.tapis.io
# SUBSIDE_STAGING_SYSTEM=cloud.data
# SUBSIDE_STAGING_PREFIX=home/{username}/subside-api

# --- CORS (dev frontend origins, comma-separated) -------------------------
# SUBSIDE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
