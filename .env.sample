# SUBSIDE API local config — copy to `.env` and fill in. `.env` is gitignored.
#   cp .env.sample .env
# Loaded by api/config.py via python-dotenv when the API starts.

# --- NASA Earthdata service account ---------------------------------------
# Dedicated Earthdata Login account used to download OPERA DISP-S1 products.
# The API builds a .netrc from these and stages it with each run, so download
# credentials never travel in the API request body. Register/manage at
# https://urs.earthdata.nasa.gov/ (a service/functional account, not a
# personal login).
EARTHDATA_USERNAME=your-earthdata-service-account
EARTHDATA_PASSWORD=your-earthdata-service-password

# --- Tapis OAuth2 login ("Log in with TACC" redirect flow) ----------------
# Register a client with workflows/register_oauth_client.py, then paste its
# output here. The client_id is public; the client_key is a server-side secret
# (never commit it). TAPIS_OAUTH_CALLBACK_URL must EXACTLY match the client's
# registered callback_url and the frontend origin (trailing slash included).
# Unset -> the /auth/* endpoints return 503 and the redirect login is hidden.
# Tapis requires an https callback, so the dev frontend must serve HTTPS (mkcert
# — see README "Local hostnames"). The callback must EXACTLY match the client's
# registered callback_url and the frontend origin (trailing slash included).
# TAPIS_CLIENT_ID=subside-portal
# TAPIS_CLIENT_KEY=your-oauth-client-secret
# TAPIS_OAUTH_CALLBACK_URL=https://subside.local:5174/

# --- TACC allocation ------------------------------------------------------
# Default allocation charged for runs when a request omits "allocation".
SUBSIDE_DEFAULT_ALLOCATION=PT2050-DataX

# --- Tapis / staging (defaults are usually fine) --------------------------
# TAPIS_BASE_URL=https://portals.tapis.io
# SUBSIDE_WORKFLOW_GROUP=subside-ops
# SUBSIDE_STAGING_SYSTEM=cloud.data
# SUBSIDE_STAGING_PREFIX=home/{username}/subside-api

# --- CORS (dev frontend origins, comma-separated) -------------------------
# SUBSIDE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostGIS vector layers (GeoJSON ingest + MVT tiles) -------------------
# Postgres *wire* endpoint behind the PostGIS database. This is NOT the
# PostgREST HTTP URL (https://subsidepostgrest.pods.portals.tapis.io) —
# psycopg speaks the postgres protocol, not HTTP. On Tapis this is the
# postgres pod reached over the pods 443 TLS-SNI tunnel. Unset -> the /layers
# and /tiles endpoints return 503 and the rest of the API is unaffected.
# Tapis pods route Postgres by SNI on :443, so libpq must negotiate TLS directly
# (sslnegotiation=direct, needs libpq >= 17). Without it you get
# "SSL error: unexpected eof while reading".
# SUBSIDE_DATABASE_URL=postgresql://USER:PASS@subsidepostgres.pods.portals.tapis.io:443/DBNAME?sslmode=require&sslnegotiation=direct
# SUBSIDE_MVT_SCHEMA=subside        # schema the API owns for ingested layers
# SUBSIDE_MVT_EXTENT=4096           # MVT tile extent
# SUBSIDE_MVT_BUFFER=64             # MVT tile buffer

# --- STAC platform (separate stac-platform service; UI build-time vars) ----
# The UI reads these at build/dev time (Vite). Unset -> STAC panel hidden.
# Note the /api/v1 prefix (the stac-platform API serves under it).
# VITE_STAC_API_BASE=https://stacapi.pods.portals.tapis.io/api/v1
# VITE_STAC_COLLECTION=subsidence-rates

# --- STAC/CKAN publishing (stac-platform) ---------------------------------
# Publishing is the `stac-publish` function task in the Tapis Workflows pipeline
# whether triggered by the API or tapis/workflows/orchestrate.py. Both the CKAN
# token and STAC write token default to the user's own Tapis token. SUBSIDE_STAC_URL
# must include the /api/v1 prefix. Unset SUBSIDE_STAC_URL -> the publish step skips.
# SUBSIDE_STAC_TOKEN / SUBSIDE_CKAN_TOKEN override only if you want service tokens.
# SUBSIDE_STAC_URL=https://stacapi.pods.portals.tapis.io/api/v1
# SUBSIDE_STAC_TOKEN=
# SUBSIDE_STAC_COLLECTION=subsidence-rates
# SUBSIDE_CKAN_URL=https://ckan.tacc.utexas.edu
# SUBSIDE_CKAN_ORG=tacc-water
# SUBSIDE_CKAN_TOKEN=
